{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/translate.mjs": {
      "includeFiles": "src/data/phrases.json"
    },
    "api/[...path].mjs": {
      "includeFiles": "src/data/phrases.json"
    }
  }
}
