# ── Supabase (obrigatório para as salas multi-participante) ──────────────
# Painel Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # "service_role" — NUNCA expor no frontend

# As mesmas credenciais públicas para o frontend (anon key, não a service role!)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...      # "anon / public"

# ── OpenRouter (tradução GPT-audio + voz TTS/STT) ───────────────────────
# Sem esta chave, as salas usam tradução mock "[traduzido] ..."
OPENROUTER_API_KEY=sk-or-...
# gpt-4o-mini = texto rápido. gpt-audio é só para voz (TTS/STT), não para traduzir.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Voz no recetor (OpenRouter /audio/speech). Opcional — cai no Web Speech do telemóvel.
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts

# ── STT / Whisper ────────────────────────────────────────────────────────
# Se STT_API_KEY estiver vazia, usa-se a chave OpenRouter (whisper-large-v3).
# STT_API_KEY=sk-...
# STT_API_URL=https://openrouter.ai/api/v1/audio/transcriptions
# STT_MODEL=openai/whisper-large-v3
# Opcional: URL HTTPS pública (túnel). Sem isto o QR usa a LAN (mesma Wi-Fi).
# PUBLIC_ORIGIN=https://xxxxx.trycloudflare.com
